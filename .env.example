OPENAI_API_KEY=your_openai_api_key_here
PORT=3018
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium

# App/session
SESSION_SECRET=change_this_for_production
APP_BASE_URL=http://localhost:3018
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3018
HOURLY_GENERATION_REQUEST_LIMIT=30
REQUIRE_EMAIL_VERIFICATION=false

# Monthly plan limits
FREE_MONTHLY_GENERATIONS=3
PRO_MONTHLY_GENERATIONS=100

# PostgreSQL (leave blank for local JSON fallback)
DATABASE_URL=
DATABASE_SSL=true

# Email: console for local testing, resend for production
EMAIL_MODE=console
RESEND_API_KEY=
EMAIL_FROM=

# Cloud storage - S3 compatible (Cloudflare R2 works)
# Leave blank to use local outputs/ storage.
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=false

# Stripe test/live mode
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
